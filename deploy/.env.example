# Root-owned .env for the relay (on the VPS: chown root:root, chmod 600).
# Nothing here is committed. Copy to deploy/.env on the box and fill in.

# --- TLS / DNS (Caddy) ------------------------------------------------------
PRAXIS_DOMAIN=praxis.edelsteinconsulting.com
PRAXIS_ACME_EMAIL=michael@edelsteinconsulting.com

# --- Reasoning --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key
# PRAXIS_REASONING_MODEL=claude-opus-4-20250514
# PRAXIS_CHAT_MODEL=claude-sonnet-4-20250514
PRAXIS_USER_NAME=Michael
# PRAXIS_DEFAULT_PROJECT=praxis

# --- Device <-> server auth -------------------------------------------------
PRAXIS_AUTH_SECRET=change-me-to-a-long-random-string

# --- Voice (mobile token minting) -------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_AGENT_ID=your-voice-engine-agent-id

# --- Task dispatch (Slack-routed) -------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
CURSOR_BRIDGE_BOT_ID=U0XXXXXXX

# --- GitHub MCP -------------------------------------------------------------
GITHUB_TOKEN=ghp_your_token

# HOST/PORT are set by the image (0.0.0.0:8080); do not override here.
