# --- Reasoning (required) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional model overrides (defaults: Opus-class loop, Sonnet-class chat)
# PRAXIS_REASONING_MODEL=claude-opus-4-8
# PRAXIS_CHAT_MODEL=claude-sonnet-5
# PRAXIS_USER_NAME=Michael
# PRAXIS_DEFAULT_PROJECT=praxis

# --- Device <-> server auth (required) --------------------------------------
# Shared bearer secret presented by your phone/desktop on the WS handshake and
# the /voice/token endpoint. Generate a long random string.
PRAXIS_AUTH_SECRET=change-me-to-a-long-random-string

# --- Voice (needed for the mobile token endpoint) ---------------------------
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_AGENT_ID=your-voice-engine-agent-id

# --- Task dispatch (Slack-routed to cursor-slack-bridge) --------------------
# A Slack bot/user token Praxis posts with. A SEPARATE "Praxis Dispatcher"
# Slack app is recommended (see ARCHITECTURE_FINDINGS.md §2.1).
SLACK_BOT_TOKEN=xoxb-...
# The cursor-slack-bridge bot's user id (so we can @-mention it to trigger it).
CURSOR_BRIDGE_BOT_ID=U0XXXXXXX

# --- GitHub MCP (first integration) -----------------------------------------
GITHUB_TOKEN=ghp_your_token
# MCP_GITHUB_ENABLED=true
# MCP_GITHUB_COMMAND=npx
# MCP_GITHUB_ARGS=-y @modelcontextprotocol/server-github

# --- Extra MCP servers (optional, JSON array of McpServerConfig) -------------
# PRAXIS_MCP_SERVERS=[{"id":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/path"]}]

# --- Networking -------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
