# Mobile build-time config (consumed by app.config.ts -> Expo `extra`).

# Which brain to talk to. Default is the always-on relay. For local dev against
# your desktop, use your machine's LAN IP, e.g. ws://192.168.1.50:8080
PRAXIS_BRAIN_ENDPOINT=wss://praxis.edelsteinconsulting.com

# Shared bearer secret (must match the server's PRAXIS_AUTH_SECRET).
PRAXIS_AUTH_SECRET=change-me-to-match-the-server

# ElevenLabs Voice Engine agent id (configured with a Custom LLM pointing at the
# server's /v1/chat/completions).
ELEVENLABS_AGENT_ID=your-voice-engine-agent-id
