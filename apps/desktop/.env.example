# --- Reasoning (required) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key
# PRAXIS_REASONING_MODEL=claude-opus-4-20250514
# PRAXIS_CHAT_MODEL=claude-sonnet-4-20250514
PRAXIS_USER_NAME=Michael
# PRAXIS_DEFAULT_PROJECT=praxis

# --- Voice (ElevenLabs; key stays in the desktop main process) --------------
ELEVENLABS_API_KEY=your-elevenlabs-key
# A voice id from your ElevenLabs voice library (required for spoken replies).
ELEVENLABS_VOICE_ID=your-voice-id

# --- Task dispatch (Slack-routed to cursor-slack-bridge) --------------------
SLACK_BOT_TOKEN=xoxb-...
CURSOR_BRIDGE_BOT_ID=U0XXXXXXX

# --- GitHub MCP -------------------------------------------------------------
GITHUB_TOKEN=ghp_your_token
# MCP_GITHUB_ENABLED=true

# --- Hive-mind: which projects to map --------------------------------------
# Comma-separated roots scanned for local repos (mirrors cursor-slack-bridge).
# PRAXIS_PROJECT_ROOTS=/Volumes/ExternalSSD/Developer/Projects,/Users/you/Developer

# --- Mac control (browser / Finder / iMessage) -----------------------------
# Set to false to disable the local automation tools entirely.
# PRAXIS_MAC_CONTROL=true

# --- Sub-agents ------------------------------------------------------------
# How many autonomous sub-agents may run at once.
# PRAXIS_SUBAGENT_CONCURRENCY=3

# --- UX ---------------------------------------------------------------------
# Global hotkey to summon the dashboard from anywhere.
PRAXIS_HOTKEY=CommandOrControl+Shift+Space
